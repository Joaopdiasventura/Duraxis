{
  "name": "duraxis",
  "version": "0.0.0",
  "private": true,
  "description": "Monorepo for the modular Duraxis embedded database libraries.",
  "author": "João Paulo Dias <joaopdias.dev@gmail.com>",
  "license": "ISC",
  "engines": {
    "node": ">=22.12.0",
    "pnpm": ">=12.16.1"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm build && pnpm -r --if-present typecheck",
    "typecheck:only": "pnpm -r --if-present typecheck",
    "test": "pnpm build && vitest run",
    "test:run": "vitest run",
    "test:watch": "pnpm build && vitest",
    "test:coverage": "pnpm build && vitest run --coverage",
    "test:storage": "pnpm build && vitest run --project @duraxis/storage",
    "test:memory": "pnpm build && vitest run --project @duraxis/storage-memory",
    "test:packages": "pnpm -r --if-present test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "changeset:status": "changeset status",
    "version-packages": "changeset version",
    "release": "changeset publish",
    "validate:manifests": "node scripts/validate-packages.mjs manifests",
    "validate:artifacts": "node scripts/validate-packages.mjs artifacts",
    "pack:check": "pnpm build && node scripts/validate-packages.mjs pack",
    "pack:check:built": "node scripts/validate-packages.mjs pack",
    "validate:release": "pnpm format:check && pnpm build && pnpm typecheck && pnpm test:run && pnpm pack:check:built"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.16.1",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.16.1",
  "type": "module",
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  }
}
