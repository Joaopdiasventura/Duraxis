{
  "name": "@duraxis/cli",
  "version": "0.5.1",
  "description": "Project setup, configuration, migrations and administration tooling for Duraxis.",
  "license": "ISC",
  "author": "Jo\u00e3o Paulo Dias <joaopdias.dev@gmail.com>",
  "keywords": [
    "duraxis",
    "database",
    "embedded",
    "transactions",
    "typescript",
    "cli",
    "configuration",
    "migrations",
    "nestjs",
    "administration"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Joaopdiasventura/Duraxis.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/Joaopdiasventura/Duraxis/tree/main/packages/cli#readme",
  "bugs": {
    "url": "https://github.com/Joaopdiasventura/Duraxis/issues"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node ../../scripts/build-cli-bin.mjs",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@duraxis/core": "workspace:*",
    "@duraxis/migrations": "workspace:*",
    "@duraxis/orm": "workspace:*",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@duraxis/storage-memory": "workspace:*",
    "@duraxis/storage-disk": "workspace:*",
    "reflect-metadata": "^0.2.2"
  },
  "bin": {
    "duraxis": "./dist/bin.js"
  }
}
